NODE_ENV=development
PORT=3000
# PostgreSQL connection URL. The running container uses postgres:123456.
# Adjust credentials if your container was started with different env vars.
DATABASE_URL=postgresql://postgres:123456@localhost:5432/trellis_dev
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900

# --- Production deployment ---
#
# NODE_ENV=production
#   Disables TypeORM query logging (see database.module.ts) and is the
#   conventional signal most Node tooling checks to enable production-only
#   behavior.
#
# DATABASE_URL
#   Point at a managed PostgreSQL instance (RDS, Cloud SQL, etc.), not this
#   container. Use a connection string with a real username/password and,
#   for most managed providers, `?sslmode=require` appended so the driver
#   negotiates TLS rather than connecting in plaintext.
#
# JWT_SECRET
#   Generate a real secret, never the placeholder above:
#     openssl rand -base64 48
#   Treat it as any other credential: injected by the deployment platform's
#   own secret store (not committed, not baked into a Docker image layer),
#   and rotating it invalidates every access token currently in flight
#   (refresh tokens are unaffected, they are not JWTs, see Auth Model).
#
# JWT_ACCESS_TTL
#   900 (15 minutes) is a reasonable default for production too; lowering
#   it shrinks the window a leaked access token stays usable at the cost of
#   more frequent POST /auth/refresh calls from clients.
