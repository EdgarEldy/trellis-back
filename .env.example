NODE_ENV=development
PORT=3000
# Adjust credentials to match the running PostgreSQL container.
# The PostgreSQL container runs in Docker (WSL2) and exposes port 5432 on localhost.
# Default credentials below assume a postgres:postgres container; update if your setup differs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trellis_dev
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900
